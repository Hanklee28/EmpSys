<div class="container-fluid">

    <!-- Page Heading -->
    <h1 class="h3 mb-4 text-gray-800">Test2</h1>
    <!-- Circle Buttons -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Test2</h6>
        </div>
        <div class="card-body">
            @{
                ViewBag.Title = "API 查詢";
            }

            <h2>API 查詢範例</h2>
            <div class="form-group">
                <label for="apiSelect">選擇 API：</label>
                <select id="apiSelect" class="form-control" style="width: 200px;">
                    <option value="/api/employee/db">查詢員工 (部門編號)</option>
                    <option value="/api/employee/EmpInfo">查詢員工 (資訊)</option>
   @*                  <option value="/orders">查詢訂單 (訂單編號)</option> *@
                </select>
            </div>


            <label for="queryInput">輸入查詢參數：</label>
            <input type="text" id="queryInput" placeholder="輸入編號..." />
            <!-- 查詢按鈕 -->
            <button id="loadEmployees" onclick="fetchData()" class="btn btn-primary">查詢</button>
            <!-- Loading Spinner -->
            <div id="loadingSpinner" class="spinner-border text-primary ml-3" role="status" style="display: none;">
                <span class="sr-only">Loading...</span>
            </div>
            <!-- 結果顯示區 -->
            <h3>查詢結果：</h3>
            <pre id="result"></pre>

@*             <br />
            <br /> *@

